# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                        LumiPay — Environment Setup                         ║
# ║                                                                            ║
# ║  Copy this file to create your local env files:                            ║
# ║    1. cp .env.example .env          → For Hardhat / Smart Contract deploy  ║
# ║    2. cp .env.example .env.local    → For Next.js frontend runtime         ║
# ║                                                                            ║
# ║  ⚠ NEVER commit .env or .env.local to git!                                ║
# ║  ⚠ NEVER share your PRIVATE_KEY with anyone!                              ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Blockchain Deployment & Subscription Relayer ──────────────────────────────
# LOCALLY (Hardhat): This is your Deployer wallet private key.
# IN VERCEL (Production): Set this to your Gas Relayer wallet private key.
# Generate a DEDICATED wallet for both — NEVER use your personal wallet!
# Testnet: get ARC testnet faucet → https://testnet.arc.network
PRIVATE_KEY=your_private_key_here

# USDC contract address on the target network
# Arc Testnet: 0x3600000000000000000000000000000000000000
# Arc Mainnet: (TBD — replace when mainnet launches)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── Next.js Frontend (prefix NEXT_PUBLIC_ = exposed to browser) ─────────────────

# Goldsky Subgraph endpoint for on-chain data indexing
# Get yours at: https://app.goldsky.com
NEXT_PUBLIC_GOLDSKY_URL=your_goldsky_subgraph_url

# Reown (WalletConnect) AppKit Project ID for wallet connection & social login
# Get yours at: https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# ── Server-Side Only (NO NEXT_PUBLIC_ prefix = NOT exposed to browser) ──────────

# Google Gemini API Key for the AI assistant feature
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Cron Job Secret for protecting automated subscription relayer endpoint
# Generate a random string: openssl rand -hex 32
# On Vercel, this is automatically sent as Bearer token to cron endpoints
CRON_SECRET=your_random_cron_secret
